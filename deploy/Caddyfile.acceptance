{
	admin off
	auto_https off
}

http://:8080 {
	encode zstd gzip

	# Health is unprefixed inside FastAPI; other API routes retain /api.
	handle /api/healthz {
		rewrite * /healthz
		reverse_proxy api:8000
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /api {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
